# ============================================================================
# FIVSED Environment Configuration
# ============================================================================

# Supabase Public Keys (Used on browser and server)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Used ONLY by server-side /api/events ingestion)
# NEVER expose this key to client-side code!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ESP32 Device Ingestion API Key / Secret (Used for authenticating POST /api/events)
# Must match the API key flashed onto the ESP32 microcontroller
DEVICE_API_KEY=fivsed_sec_key_77e9b812a4309c48

# Application Settings
NEXT_PUBLIC_DEFAULT_VERIFICATION_INTERVAL=10
NEXT_PUBLIC_DEMO_MODE=false
